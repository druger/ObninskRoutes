<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:orientation="horizontal"
    android:background="@drawable/list_selector"
    tools:context="ru.example.druger.obninskroutes.search.RecordActivity">

    <ImageView
        android:id="@+id/ic_searchable_route"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_alignParentLeft="true"
        android:layout_marginRight="5dp"/>

    <TextView
        android:id="@+id/searchable_stop"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choosen_stop_from_suggestion"
        android:textColor="#040404"
        android:typeface="sans"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/ic_searchable_route"
        android:layout_toEndOf="@+id/ic_searchable_route"/>

</RelativeLayout>
